#!/usr/bin/env bash
set -euo pipefail

# Thin wrapper for codex-local-lane CLI
# Sets PYTHONPATH to this repository's src directory

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export PYTHONPATH="$REPO_ROOT/src:${PYTHONPATH:-}"

exec python3 -m codex_local_harness.lane_cli "$@"
