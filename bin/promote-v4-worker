#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
install_bin=${CODEX_LOCAL_INSTALL_BIN:-/home/connellwc83/.local/bin}
backup_root=${CODEX_LOCAL_BACKUP_ROOT:-/home/connellwc83/.local/share/codex-local-harness/backups}
stable_worker=${CODEX_LOCAL_STABLE_WORKER:-$install_bin/codex-local-worker}
candidate_worker=${CODEX_LOCAL_CANDIDATE_WORKER:-$script_dir/codex-local-worker-v4}
candidate_model_manager=${CODEX_LOCAL_CANDIDATE_MODEL_MANAGER:-$script_dir/codex-local-model}
candidate_workers_config=${CODEX_LOCAL_CANDIDATE_WORKERS_CONFIG:-$script_dir/../config/workers-vllm.json}
candidate_source=${CODEX_LOCAL_CANDIDATE_SOURCE:-$script_dir/../src}
installed_model_manager=${CODEX_LOCAL_MODEL_MANAGER:-$install_bin/codex-local-model}
installed_workers_config=${CODEX_LOCAL_WORKER_CONFIG:-}
if [[ -z $installed_workers_config ]]; then
  if [[ $install_bin == /home/connellwc83/.local/bin ]]; then
    installed_workers_config=/home/connellwc83/.config/codex-local/workers.json
  else
    installed_workers_config=$install_bin/workers.json
  fi
fi
runtime_root=${CODEX_LOCAL_RUNTIME_ROOT:-/home/connellwc83/.local/share/codex-local-harness/runtime}
release_manifest=${CODEX_LOCAL_RELEASE_MANIFEST:-$script_dir/../config/installed-release.json}
candidate_dashboard_unit=${CODEX_LOCAL_DASHBOARD_UNIT:-$script_dir/../deployment/dashboard-backend.service}
user_unit_dir=${CODEX_LOCAL_USER_UNIT_DIR:-/home/connellwc83/.config/systemd/user}
systemctl_bin=${CODEX_LOCAL_SYSTEMCTL:-systemctl}
install_units=${CODEX_LOCAL_INSTALL_UNITS:-}
if [[ -z $install_units ]]; then
  [[ $install_bin == /home/connellwc83/.local/bin ]] && install_units=1 || install_units=0
fi

for required in "$stable_worker" "$candidate_worker" "$candidate_model_manager" "$candidate_workers_config" "$release_manifest"; do
  [[ -f $required ]] || { echo "ERROR: required worker is missing: $required" >&2; exit 2; }
done
[[ -d $candidate_source/codex_local_harness ]] || {
  echo "ERROR: candidate Python source is missing: $candidate_source/codex_local_harness" >&2
  exit 2
}
find "$candidate_source/codex_local_harness" -type f -name '*.py' -print -quit | grep -q . || {
  echo "ERROR: candidate Python source contains no modules" >&2
  exit 2
}
bash -n "$candidate_worker"
bash -n "$candidate_model_manager"
jq -e '.routes and .defaults' "$candidate_workers_config" >/dev/null
observed_stable=$(sha256sum "$stable_worker" | cut -d' ' -f1)
observed_candidate=$(sha256sum "$candidate_worker" | cut -d' ' -f1)
jq -e --arg digest "$observed_stable" '.qualified_worker_sha256 | index($digest) != null' \
  "$release_manifest" >/dev/null || {
  echo "ERROR: stable worker is not a qualified release: $observed_stable" >&2
  exit 65
}
jq -e --arg digest "$observed_candidate" '.qualified_worker_sha256 | index($digest) != null' \
  "$release_manifest" >/dev/null || {
  echo "ERROR: candidate worker is not a qualified release: $observed_candidate" >&2
  exit 65
}

backup_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
backup_dir=$backup_root/$backup_id
install -d -m 700 "$install_bin" "$backup_root" "$backup_dir" "$runtime_root"
install -m 600 "$stable_worker" "$backup_dir/codex-local-worker"
printf '%s  codex-local-worker\n' "$observed_stable" >"$backup_dir/SHA256SUMS"
if [[ -f $installed_model_manager ]]; then
  install -m 600 "$installed_model_manager" "$backup_dir/codex-local-model"
  printf '%s  codex-local-model\n' "$(sha256sum "$installed_model_manager" | cut -d' ' -f1)" >>"$backup_dir/SHA256SUMS"
else
  : >"$backup_dir/codex-local-model.absent"
fi
if [[ -f $installed_workers_config ]]; then
  install -m 600 "$installed_workers_config" "$backup_dir/workers.json"
  printf '%s  workers.json\n' "$(sha256sum "$installed_workers_config" | cut -d' ' -f1)" >>"$backup_dir/SHA256SUMS"
else
  : >"$backup_dir/workers.json.absent"
fi
if [[ -L $runtime_root/current ]]; then
  readlink "$runtime_root/current" >"$backup_dir/runtime-target"
fi
chmod 600 "$backup_dir/SHA256SUMS"
if [[ $install_units == 1 ]]; then
  [[ -f $candidate_dashboard_unit ]] || {
    echo "ERROR: dashboard unit is missing: $candidate_dashboard_unit" >&2
    exit 2
  }
  install -d -m 700 "$user_unit_dir"
  control_token_file=${CODEX_LOCAL_CONTROL_TOKEN_FILE:-/home/connellwc83/.config/codex-local/dashboard-control.token}
  control_audit_dir=${CODEX_LOCAL_CONTROL_AUDIT_DIR:-/home/connellwc83/.local/share/codex-local-harness/control}
  install -d -m 700 "$(dirname -- "$control_token_file")" "$control_audit_dir"
  if [[ ! -s $control_token_file ]]; then
    python3 -c 'import secrets; print(secrets.token_urlsafe(32))' >"$control_token_file"
  fi
  chmod 600 "$control_token_file"
  if [[ -f $user_unit_dir/dashboard-backend.service ]]; then
    install -m 600 "$user_unit_dir/dashboard-backend.service" "$backup_dir/dashboard-backend.service"
  fi
fi

bundle_hash=$(
  cd "$candidate_source"
  find codex_local_harness -type f -name '*.py' -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1
)
runtime_dir=$runtime_root/$bundle_hash
if [[ ! -d $runtime_dir/src/codex_local_harness ]]; then
  runtime_tmp=$(mktemp -d --tmpdir="$runtime_root")
  while IFS= read -r -d '' source_file; do
    relative_path=${source_file#"$candidate_source/"}
    install -D -m 600 "$source_file" "$runtime_tmp/src/$relative_path"
  done < <(find "$candidate_source/codex_local_harness" -type f -name '*.py' -print0 | sort -z)
  mv "$runtime_tmp" "$runtime_dir"
fi
ln -s "$runtime_dir" "$runtime_root/current.new"
mv -Tf "$runtime_root/current.new" "$runtime_root/current"
install -m 755 "$candidate_worker" "$stable_worker"
install -m 755 "$candidate_model_manager" "$installed_model_manager"
install -D -m 600 "$candidate_workers_config" "$installed_workers_config"
if [[ $install_units == 1 ]]; then
  install -m 644 "$candidate_dashboard_unit" "$user_unit_dir/dashboard-backend.service"
  "$systemctl_bin" --user daemon-reload
  "$systemctl_bin" --user try-restart dashboard-backend.service
fi

promotion_status=promoted
[[ $observed_stable == "$observed_candidate" ]] && promotion_status=runtime-refreshed
printf 'status=%s\nbackup=%s\nruntime=%s\nworker_sha256=%s\n' \
  "$promotion_status" "$backup_dir" "$runtime_dir" "$(sha256sum "$stable_worker" | cut -d' ' -f1)"
