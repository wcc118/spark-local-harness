#!/usr/bin/env python3
"""Maintainer command: freeze reviewed runtime bytes before release installation."""
import hashlib
import json
from pathlib import Path
root = Path(__file__).resolve().parent.parent
paths = []
for directory in ('src', 'agents', 'config', 'docker', 'docs'):
    paths.extend(p for p in (root / directory).rglob('*')
                 if p.is_file() and '__pycache__' not in p.parts and p.suffix != '.pyc'
                 and p.name != 'portable-release.json')
for name in ('install-harness', 'codex-local-worker-candidate', 'codex-local-worker-v4',
             'codex-local-supervise', 'codex-local-completion', 'codex-local-model',
             'codex-local-deepseek-v4'):
    paths.append(root / 'bin' / name)
paths.extend(root / name for name in ('README.md', 'AGENTS.md', 'pyproject.toml'))
manifest = {
    'schema': 1,
    'qualified_base': '3721487c0790b98e3467017bd5b966802e3d96c6',
    'dependencies': {'python': '>=3.11', 'opencode': '1.18.21', 'codex': '0.155.1',
                     'qwen-code': '0.22.0', 'worker_image': 'codex-local-worker:0.2.0',
                     'qualified_worker_image_id': 'sha256:c9ed185412880596b7ce932d2bcf74af50ba983f985592eea8f3571eef123f7d'},
    'files': {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
              for p in sorted(paths)},
}
(root / 'config/portable-release.json').write_text(json.dumps(manifest, indent=2) + '\n')
