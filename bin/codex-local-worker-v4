#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: codex-local-worker ROLE REPOSITORY_PATH TASK..." >&2
  echo "       codex-local-worker ROLE REPOSITORY_PATH --task-file FILE" >&2
  echo "roles: helper, coder, reviewer" >&2
  exit 2
}

(( $# >= 3 )) || usage
worker_role=$1
worker_source_repo_path=$2
worker_repo_path=$2
shift 2

task_temp=
review_runtime_tmp=
worker_runtime_home=
worker_isolation_root=
worker_server_pid=
worker_server_container=
worker_control=
worker_control_secret=
worker_model_lock_fd=
isolation_parent=${CODEX_LOCAL_ISOLATION_PARENT:-${HOME}/.local/share/opencode-orchestration/isolated-checkouts}
supervision_admitted=0
convergence=${CODEX_LOCAL_CONVERGENCE:-0}
health_dir=${CODEX_LOCAL_HEALTH_DIR:-${HOME}/.local/share/codex-local-harness/health}
diagnostic_started=0
diagnostic_finalized=0
worker_started_epoch=
worker_memory_test_db=0
cleanup() {
  cleanup_status=$?
  if [[ -n $worker_server_container ]]; then
    docker stop --time 5 "$worker_server_container" >/dev/null 2>&1 || true
  fi
  if [[ -n $worker_server_pid ]]; then
    wait "$worker_server_pid" 2>/dev/null || true
  fi
  if [[ -n $worker_control && -f $worker_control ]] && jq -e '.state == "active"' "$worker_control" >/dev/null 2>&1; then
    control_state=interrupted
    (( cleanup_status != 0 )) && control_state=failed
    case "$cleanup_status" in
      124|137) control_state=timed-out ;;
      130|143) control_state=interrupted ;;
    esac
    jq --arg state "$control_state" '.state = $state | .credential_file = null' "$worker_control" >"$worker_control.tmp" \
      && chmod 600 "$worker_control.tmp" && mv "$worker_control.tmp" "$worker_control" || true
  fi
  if [[ -n $worker_control_secret ]]; then
    rm -f -- "$worker_control_secret"
  fi
  if [[ $worker_memory_test_db == 1 ]]; then
    if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.memory_test_db cleanup --run-id "$worker_run_id"; then
      echo "ERROR: disposable test database cleanup failed; inspect owned resources before retry" >&2
      (( cleanup_status != 0 )) || cleanup_status=70
    fi
  fi
  if [[ $diagnostic_started == 1 && $diagnostic_finalized == 0 ]]; then
    diagnostic_event=cancelled
    case "$cleanup_status" in
      124|137) diagnostic_event=timed-out ;;
      130|143) diagnostic_event=interrupted ;;
    esac
    diagnostic_now=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
    diagnostic_elapsed=$(( $(date -u +%s) - worker_started_epoch ))
    diagnostic_dirty=0
    if [[ $worker_role == coder && -d $worker_repo_path ]]; then
      diagnostic_status_snapshot=$(git -C "$worker_repo_path" status --porcelain=v1 2>/dev/null || true)
      if [[ -n $diagnostic_status_snapshot ]]; then
        diagnostic_dirty=$(grep -c '^' <<<"$diagnostic_status_snapshot")
      fi
    fi
    if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.diagnostic_cli lifecycle \
      --records "$lifecycle_records" --event-id "$worker_run_id:$diagnostic_event" \
      --run-id "$worker_run_id" --event "$diagnostic_event" --observed-at "$diagnostic_now" \
      --wall-seconds "$diagnostic_elapsed" --exit-status "$cleanup_status" \
      --dirty-entries "$diagnostic_dirty" --issue "$worker_issue" --role "$worker_role" \
      --model "$worker_model" --profile codex-led-v4 --task-class "${CODEX_LOCAL_TASK_CLASS:-unclassified}" \
      "${lifecycle_checkout_args[@]}" \
      >/dev/null; then
      echo "WARN: lifecycle telemetry ingestion failed for run $worker_run_id" >&2
      record_publication_failure cleanup lifecycle
    fi
    if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.observe_cli workflow \
      --records "$workflow_records" --event-id "$worker_run_id:$diagnostic_event" \
      --operation-id "$worker_operation_id" --stage "$worker_workflow_stage" --state interrupted \
      --observed-at "$diagnostic_now" --issue "$worker_issue" --run-id "$worker_run_id" \
      --role "$worker_role" --model "$worker_model" --stop-reason "$diagnostic_event" \
      "${workflow_identity_args[@]}" >/dev/null; then
      echo "WARN: workflow telemetry ingestion failed for run $worker_run_id" >&2
      record_publication_failure cleanup workflow
    fi
  fi
  if [[ -n $task_temp && -f $task_temp ]]; then
    rm -f -- "$task_temp"
  fi
  if [[ $convergence != 1 && -n $review_runtime_tmp && -d $review_runtime_tmp ]]; then
    rm -rf -- "$review_runtime_tmp"
  fi
  if [[ -n $worker_runtime_home && -d $worker_runtime_home ]]; then
    rm -rf -- "$worker_runtime_home"
  fi
  if [[ $convergence != 1 && -n $worker_isolation_root && -d $worker_isolation_root && $worker_isolation_root == "$isolation_parent"/* ]]; then
    rm -rf -- "$worker_isolation_root"
  fi
  if [[ $supervision_admitted == 1 ]]; then
    env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.supervision --health "$health_dir" --session "$worker_session_id" finish "$worker_run_id" --exit-status "$cleanup_status" || echo "ERROR: terminal ownership record failed; retained work requires inspection" >&2
    echo "Retained checkpoint: $worker_repo_path (not a live model session)" >&2
  fi
  exit "$cleanup_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ ${1:-} == --task-file ]]; then
  (( $# == 2 )) || usage
  [[ -r $2 ]] || { echo "ERROR: task file is not readable: $2" >&2; exit 2; }
  worker_task_file=$2
  worker_task=$(<"$2")
else
  worker_task=$*
  task_temp=$(mktemp)
  printf '%s\n' "$worker_task" >"$task_temp"
  worker_task_file=$task_temp
fi

[[ -n $worker_task ]] || { echo "ERROR: task must not be empty" >&2; exit 2; }
case "$worker_role" in helper|coder|reviewer) ;; *) usage ;; esac
case "$worker_role" in
  helper) max_task_chars=${CODEX_LOCAL_MAX_TASK_CHARS:-12000} ;;
  coder) max_task_chars=${CODEX_LOCAL_MAX_TASK_CHARS:-24000} ;;
  reviewer) max_task_chars=${CODEX_LOCAL_MAX_TASK_CHARS:-24000} ;;
esac
[[ "$max_task_chars" =~ ^[1-9][0-9]*$ ]] || {
  echo "ERROR: CODEX_LOCAL_MAX_TASK_CHARS must be a positive integer" >&2; exit 2;
}
(( ${#worker_task} <= max_task_chars )) || {
  echo "ERROR: task packet exceeds the $max_task_chars character bound; pass issue references and bounded evidence instead of transcripts" >&2
  exit 2
}
case "$worker_role" in
  coder) worker_workflow_stage=local-work ;;
  reviewer) worker_workflow_stage=review ;;
  helper) worker_workflow_stage=evidence ;;
esac
[[ -d "$worker_repo_path" ]] || { echo "ERROR: repository path is not a directory: $worker_repo_path" >&2; exit 2; }

worker_config=${CODEX_LOCAL_WORKER_CONFIG:-${HOME}/.config/codex-local/workers.json}
[[ -r "$worker_config" ]] || { echo "ERROR: worker routing config is not readable: $worker_config" >&2; exit 2; }
jq -e '.routes and .defaults' "$worker_config" >/dev/null || { echo "ERROR: invalid worker routing config" >&2; exit 2; }

worker_tier=${CODEX_LOCAL_TIER:-$(jq -er --arg role "$worker_role" '.defaults[$role]' "$worker_config")}
worker_route="$worker_role/$worker_tier"
configured_agent=$(jq -er --arg route "$worker_route" '.routes[$route].agent' "$worker_config") || {
  echo "ERROR: no configured route for $worker_route" >&2; exit 2;
}
worker_agent=${CODEX_LOCAL_AGENT:-$configured_agent}
worker_model=${CODEX_LOCAL_MODEL:-$(jq -er --arg route "$worker_route" '.routes[$route].model' "$worker_config")}
worker_runtime=$(jq -r --arg route "$worker_route" '.routes[$route].runtime // "opencode"' "$worker_config")
worker_mode=$(jq -r --arg route "$worker_route" '.routes[$route].mode // "tailored"' "$worker_config")
case "$worker_runtime" in opencode|qwen-code) ;; *) echo "ERROR: unsupported worker runtime: $worker_runtime" >&2; exit 2 ;; esac
case "$worker_mode" in native|tailored) ;; *) echo "ERROR: unsupported worker mode: $worker_mode" >&2; exit 2 ;; esac
if [[ $worker_runtime == qwen-code && ( $worker_role != coder || $worker_mode != native ) ]]; then
  echo "ERROR: qwen-code is qualified only for native coder routes" >&2
  exit 2
fi

if [[ "$worker_model" == lmstudio/* ]]; then
  lmstudio_base_url=${LMSTUDIO_BASE_URL:-http://10.0.0.92:1234/v1}
  curl_args=(--fail --silent --show-error --connect-timeout 3 --max-time 8)
  [[ -z ${LMSTUDIO_API_TOKEN:-} ]] || curl_args+=(--header "Authorization: Bearer $LMSTUDIO_API_TOKEN")
  model_catalog=$(curl "${curl_args[@]}" "$lmstudio_base_url/models") || {
    echo "ERROR: LM Studio is unavailable at $lmstudio_base_url" >&2; exit 69;
  }
  lmstudio_model=${worker_model#lmstudio/}
  jq -e --arg model "$lmstudio_model" '.data[]? | select(.id == $model)' <<<"$model_catalog" >/dev/null || {
    echo "ERROR: LM Studio model is unavailable: $lmstudio_model" >&2; exit 69;
  }
fi

if [[ ${CODEX_LOCAL_DRY_RUN:-0} == 1 ]]; then
  printf 'role=%s\nagent=%s\nmodel=%s\nruntime=%s\nmode=%s\ntier=%s\nrepo=%s\n' \
    "$worker_role" "$worker_agent" "$worker_model" "$worker_runtime" "$worker_mode" "$worker_tier" "$worker_repo_path"
  exit 0
fi

case "$worker_role" in
  helper) default_worker_timeout=300 ;;
  reviewer) default_worker_timeout=120 ;;
  coder) default_worker_timeout=1800 ;;
esac
if [[ $convergence == 1 && ( $worker_role == coder || $worker_role == reviewer ) ]]; then
  default_worker_timeout=0
fi
worker_timeout=${CODEX_LOCAL_TIMEOUT_SECONDS:-$default_worker_timeout}
[[ "$worker_timeout" =~ ^[0-9]+$ && ( "$worker_timeout" != 0 || "$convergence" == 1 ) ]] || {
  echo "ERROR: CODEX_LOCAL_TIMEOUT_SECONDS must be positive (candidate: 0 disables whole-task deadline)" >&2; exit 2;
}
reviewer_token_budget=${CODEX_LOCAL_REVIEWER_TOKEN_BUDGET:-250000}
[[ "$reviewer_token_budget" =~ ^[1-9][0-9]*$ ]] || {
  echo "ERROR: CODEX_LOCAL_REVIEWER_TOKEN_BUDGET must be a positive integer" >&2; exit 2;
}

if [[ ( $worker_model == vllm/* || $worker_model == deepseek/deepseek-v4-flash-0731-exl3-k2 ) && ${CODEX_LOCAL_MODEL_SWITCH:-1} == 1 ]]; then
  vllm_model=${worker_model#vllm/}
  case "$vllm_model" in
    Qwen/Qwen3.8-27B-FP8) vllm_profile=qwen38 ;;
    Qwen/Qwen3-Coder-Next-FP8) vllm_profile=coder-next ;;
    nvidia/Qwen3.5-122B-A10B-NVFP4) vllm_profile=qwen35-nvfp4 ;;
    deepseek/deepseek-v4-flash-0731-exl3-k2) vllm_profile=deepseek-v4-reasoning ;;
    *) echo "ERROR: unsupported vLLM worker model: $vllm_model" >&2; exit 69 ;;
  esac
  model_manager=${CODEX_LOCAL_MODEL_MANAGER:-${HOME}/.local/bin/codex-local-model}
  model_lock=${CODEX_LOCAL_MODEL_LOCK:-${HOME}/.local/share/codex-local-harness/model.lock}
  [[ -x $model_manager ]] || { echo "ERROR: model manager is unavailable: $model_manager" >&2; exit 69; }
  install -d -m 700 "$(dirname -- "$model_lock")"
  exec {worker_model_lock_fd}>"$model_lock"
  flock --wait "${CODEX_LOCAL_MODEL_LOCK_TIMEOUT:-1800}" "$worker_model_lock_fd" || {
    echo "ERROR: timed out waiting for the vLLM model lock: $model_lock" >&2; exit 75;
  }
  CODEX_LOCAL_MODEL_LOCK_HELD=1 "$model_manager" use "$vllm_profile" || exit $?
fi

worker_run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
worker_log_dir=${CODEX_LOCAL_LOG_DIR:-${HOME}/.local/share/opencode-orchestration/runs}
install -d -m 700 "$worker_log_dir"
worker_log="$worker_log_dir/$worker_run_id.jsonl"
worker_envelope="$worker_log_dir/$worker_run_id.envelope.json"
worker_result="$worker_log_dir/$worker_run_id.result.json"
worker_control="$worker_log_dir/$worker_run_id.control.json"
worker_control_secret="$worker_log_dir/$worker_run_id.control.secret"
umask 077

# Inference must never inherit the operator's authenticated home or ambient
# credentials.  Build a disposable OpenCode home containing only the runtime
# configuration and agent prompts, then launch with an explicit environment.
worker_runtime_parent=${HOME}/.local/share/opencode-orchestration/worker-homes
install -d -m 700 "$worker_runtime_parent"
worker_runtime_home=$(mktemp -d --tmpdir="$worker_runtime_parent")
install -d -m 700 "$worker_runtime_home/.config/opencode/agents" "$worker_runtime_home/.qwen" \
  "$worker_runtime_home/.local/share" "$worker_runtime_home/.cache"
# Automatic OpenCode compaction is the installed auto-only baseline. Manual
# compaction is a separate controller capability and remains disabled.
jq --arg vllm_url "${CODEX_LOCAL_VLLM_ENDPOINT:-http://127.0.0.1:8000}/v1" --arg deepseek_url "${CODEX_LOCAL_DEEPSEEK_ENDPOINT:-http://127.0.0.1:8011}/v1" '.mcp = ((.mcp // {}) | with_entries(.value.enabled = false))
    | .mcp |= del(.memory)
    | .instructions = ((.instructions // []) | map(select(endswith("/projects/memory/MEMORY.md") | not)))
    | .permission.external_directory = "deny"
    | .agent.coder.permission = ((.agent.coder.permission // {}) + {
        "github_*": "deny", "gitea_*": "deny", "external_directory": "deny"
      })
    | .agent.reviewer.permission = {"*": "deny", "vision-review_review_screenshot": "allow"}
    | .agent.reviewer.steps = 4
    | .compaction = { "auto": true, "prune": true, "reserved": 16000 }
    | .provider.vllm.options.baseURL = $vllm_url
    | .provider.vllm.models."nvidia/Qwen3.5-122B-A10B-NVFP4" = {
        "name": "Qwen3.5 122B NVFP4 (Spark)",
        "limit": { "context": 65536, "output": 8192 }
      }
    | .provider.deepseek = {
        "npm": "@ai-sdk/openai-compatible",
        "name": "DeepSeek V4 Flash reasoning (Spark)",
        "options": {"baseURL": $deepseek_url},
        "models": {"deepseek-v4-flash-0731-exl3-k2": {
          "name": "DeepSeek V4 Flash reasoning",
          "limit": {"context": 1000000, "output": 32768}
        }}
      }' "${CODEX_LOCAL_OPENCODE_CONFIG:-${HOME}/.config/opencode/opencode.json}" \
  >"$worker_runtime_home/.config/opencode/opencode.json"
worker_agents=${CODEX_LOCAL_AGENTS:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../agents" && pwd)}
cp -a "$worker_agents/." "$worker_runtime_home/.config/opencode/agents/"
printf '%s\n' '{"tools":{"approvalMode":"yolo","core":["read_file","grep_search","glob","edit","write_file","run_shell_command","todo_write"],"disabled":["record_artifact","agent","list_agents","task_stop","send_message","skill","tool_search","read_mcp_resource","web_fetch","computer_use__bring_to_front","computer_use__check_for_update","computer_use__check_permissions","computer_use__click","computer_use__double_click","computer_use__drag","computer_use__end_session","computer_use__get_accessibility_tree","computer_use__get_agent_cursor_state","computer_use__get_config","computer_use__get_cursor_position","computer_use__get_recording_state","computer_use__get_screen_size","computer_use__get_window_state","computer_use__hotkey","computer_use__kill_app","computer_use__launch_app","computer_use__list_apps","computer_use__list_windows","computer_use__move_cursor","computer_use__page","computer_use__press_key","computer_use__replay_trajectory","computer_use__right_click","computer_use__scroll","computer_use__set_agent_cursor_enabled","computer_use__set_agent_cursor_motion","computer_use__set_agent_cursor_style","computer_use__set_config","computer_use__set_value","computer_use__start_recording","computer_use__start_session","computer_use__stop_recording","computer_use__type_text","computer_use__zoom","create_sub_session","enter_worktree","exit_worktree","get_goal","update_goal","monitor","loop_wakeup","cron_create","cron_list","cron_delete"]},"telemetry":{"enabled":false}}' \
  >"$worker_runtime_home/.qwen/settings.json"
if [[ $convergence == 1 && $worker_role == reviewer ]]; then
  [[ ${CODEX_LOCAL_SANDBOX:-container} == container ]] || { echo "ERROR: investigative review requires container confinement" >&2; exit 2; }
  candidate_agents=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../agents" && pwd)
  cp "$candidate_agents/convergence-reviewer.md" "$worker_runtime_home/.config/opencode/agents/convergence-reviewer.md"
  worker_agent=convergence-reviewer
  # Explicit selection is mandatory; native OpenCode otherwise chooses its default agent.
  worker_mode=tailored
fi
worker_opencode=
if [[ $worker_runtime == opencode ]]; then
  worker_opencode=${CODEX_LOCAL_OPENCODE:-$(command -v opencode)}
  [[ -x $worker_opencode ]] || { echo "ERROR: OpenCode executable is not executable: $worker_opencode" >&2; exit 2; }
fi
worker_path=${HOME}/.local/bin:${HOME}/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
worker_sandbox=${CODEX_LOCAL_SANDBOX:-container}
worker_container_image=${CODEX_LOCAL_CONTAINER_IMAGE:-codex-local-worker:0.3.0}
case "$worker_sandbox" in
  container)
    command -v docker >/dev/null || { echo "ERROR: Docker is required for worker confinement" >&2; exit 69; }
    docker image inspect "$worker_container_image" >/dev/null 2>&1 || {
      echo "ERROR: worker sandbox image is unavailable: $worker_container_image" >&2; exit 69;
    }
    ;;
  disabled)
    [[ ${CODEX_LOCAL_ALLOW_UNSANDBOXED:-0} == 1 ]] || {
      echo "ERROR: disabling worker confinement requires CODEX_LOCAL_ALLOW_UNSANDBOXED=1" >&2; exit 2;
    }
    ;;
  *) echo "ERROR: unsupported worker sandbox: $worker_sandbox" >&2; exit 2 ;;
esac

worker_repository=${CODEX_LOCAL_REPOSITORY:-}
worker_repository_display=${worker_repository:-$worker_source_repo_path}
worker_issue=${CODEX_LOCAL_ISSUE:-}
worker_pr=${CODEX_LOCAL_PR:-}
record_run=${CODEX_LOCAL_RECORD_RUN:-0}

if [[ $record_run == 1 && ( -z $worker_repository || -z $worker_issue ) ]]; then
  echo "ERROR: recording requires CODEX_LOCAL_REPOSITORY and CODEX_LOCAL_ISSUE" >&2
  exit 2
fi

candidate_source=${CODEX_LOCAL_SOURCE:-${HOME}/.local/share/codex-local-harness/runtime/current/src}
checkout_kind=source-read-only
checkout_id=$(printf '%s' "$(realpath "$worker_source_repo_path")" | sha256sum | cut -d' ' -f1)
if [[ $worker_role == coder || $worker_role == reviewer ]]; then
  source_root=$(git -C "$worker_source_repo_path" rev-parse --show-toplevel)
  [[ $(realpath "$source_root") == $(realpath "$worker_source_repo_path") ]] || {
    echo "ERROR: worker source must be the Git root" >&2; exit 65;
  }
  [[ -z $(git -C "$worker_source_repo_path" status --porcelain=v1) ]] || {
    echo "ERROR: worker source checkout must be clean before isolation" >&2; exit 65;
  }
  source_head=$(git -C "$worker_source_repo_path" rev-parse HEAD)
  source_branch=$(git -C "$worker_source_repo_path" branch --show-current)
  source_remote=$(git -C "$worker_source_repo_path" remote get-url origin)
  [[ -n $source_branch ]] || { echo "ERROR: worker source checkout must have a branch" >&2; exit 65; }
  install -d -m 700 "$isolation_parent"
  if [[ $convergence == 1 && -n ${CODEX_LOCAL_RESUME_RUN:-} ]]; then
    [[ $worker_role == coder ]] || { echo "ERROR: checkpoint continuation is coder-only; review a fresh exact revision" >&2; exit 2; }
    resume_info=$(env PYTHONPATH="${CODEX_LOCAL_SOURCE:?}" python3 -m codex_local_harness.supervision \
      --health "$health_dir" --session "${CODEX_LOCAL_SESSION_ID:-${CODEX_THREAD_ID:-}}" checkpoint "$CODEX_LOCAL_RESUME_RUN")
    jq -e --arg repo "$worker_repository" --arg issue "$worker_issue" --arg source "$worker_source_repo_path" \
      '.repository == $repo and (.issue | tostring) == $issue and .source == $source and .role == "coder"' <<<"$resume_info" >/dev/null || { echo "ERROR: checkpoint identity mismatch" >&2; exit 65; }
    worker_repo_path=$(jq -r .checkout <<<"$resume_info")
    worker_isolation_root=$(dirname -- "$worker_repo_path")
    [[ $(realpath "$worker_repo_path") == "$(realpath "$isolation_parent")"/*/checkout ]] || { echo "ERROR: checkpoint outside isolation parent" >&2; exit 65; }
    resumed_task=$(mktemp --tmpdir="$worker_log_dir" "$worker_run_id.task.XXXXXX")
    env PYTHONPATH="$CODEX_LOCAL_SOURCE" python3 -m codex_local_harness.supervision \
      --health "$health_dir" --session "${CODEX_LOCAL_SESSION_ID:-${CODEX_THREAD_ID:-}}" resume-packet "$CODEX_LOCAL_RESUME_RUN" \
      --target "$worker_run_id" --task "$worker_task_file" --output "$resumed_task"
    worker_task_file=$resumed_task
    worker_task=$(cat "$worker_task_file")
  else
    worker_isolation_root=$(mktemp -d --tmpdir="$isolation_parent")
    worker_repo_path=$worker_isolation_root/checkout
    git clone --quiet --no-hardlinks --no-checkout "$worker_source_repo_path" "$worker_repo_path"
    git -C "$worker_repo_path" remote set-url origin "$source_remote"
    git -C "$worker_repo_path" checkout --quiet -B "$source_branch" "$source_head"
  fi

  # Resolve on the host; neither the source clone's refs nor model echoes are authoritative.
  base_sha=""
  if [[ -n "$worker_repository" ]]; then
    base_args=(--checkout "$worker_repo_path" --repository "$worker_repository" --role "$worker_role")
    [[ $worker_role != reviewer ]] || base_args+=(--pr "$worker_pr")
    base_result=$(env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.base_resolution "${base_args[@]}") || exit 65
    IFS=$'\t' read -r base_branch base_sha <<< "$base_result"
    worker_task="AUTHORITATIVE_BASE branch=$base_branch sha=$base_sha"$'\n\n'"$worker_task"
  fi

  if [[ $convergence == 1 ]]; then
    exec {checkout_lock_fd}>"$worker_isolation_root/.execution.lock"
    flock -n "$checkout_lock_fd" || { echo "ERROR: retained checkout already has an active worker" >&2; exit 75; }
  fi
  checkout_kind=isolated-clone
  checkout_id=$(printf '%s' "$worker_repo_path" | sha256sum | cut -d' ' -f1)
fi

# Local commits need an identity, but not the operator's credential-bearing
# global Git configuration.
if [[ $worker_role == coder ]]; then
  [[ -n $worker_repository && -n $worker_issue ]] || {
    echo "ERROR: isolated coder requires CODEX_LOCAL_REPOSITORY and CODEX_LOCAL_ISSUE" >&2; exit 2;
  }
  git -C "$worker_repo_path" config user.name "$(git config --global user.name)"
  git -C "$worker_repo_path" config user.email "$(git config --global user.email)"
fi

[[ -d $candidate_source/codex_local_harness ]] || {
  echo "ERROR: installed harness runtime is missing: $candidate_source" >&2
  exit 69
}
lifecycle_records=${CODEX_LOCAL_LIFECYCLE_RECORDS:-$health_dir/lifecycle.jsonl}
workflow_records=${CODEX_LOCAL_WORKFLOW_RECORDS:-$health_dir/workflow.jsonl}
publication_failure_records=${CODEX_LOCAL_PUBLICATION_FAILURE_RECORDS:-$health_dir/publication-failures.jsonl}
compaction_records=${CODEX_LOCAL_COMPACTION_RECORDS:-${HOME}/.local/share/codex-local-harness/health/compaction.jsonl}
worker_operation_id=${CODEX_LOCAL_OPERATION_ID:-issue-$worker_issue}
if [[ $convergence == 1 && -z ${CODEX_LOCAL_OPERATION_ID:-} ]]; then
  worker_operation_id=issue-$worker_issue-$worker_run_id
fi
bridge_compaction_args=()
if [[ $record_run == 1 ]]; then
  bridge_compaction_args=(--issue "$worker_issue" --compaction-records "$compaction_records")
fi
workflow_identity_args=()
[[ -z $worker_pr ]] || workflow_identity_args+=(--pull-request "$worker_pr")
# Session identity (CODEX_LOCAL_SESSION_ID with fallback to CODEX_THREAD_ID, then None)
worker_session_id=${CODEX_LOCAL_SESSION_ID:-${CODEX_THREAD_ID:-}}
[[ -z $worker_session_id ]] || workflow_identity_args+=(--session-id "$worker_session_id")
# Repository (CODEX_LOCAL_REPOSITORY)
[[ -z $worker_repository ]] || workflow_identity_args+=(--repository "$worker_repository")
lifecycle_checkout_args=(--checkout-kind "$checkout_kind" --checkout-id "$checkout_id")
if [[ $convergence == 1 ]]; then
  [[ $record_run == 1 && -n $worker_session_id ]] || {
    echo "ERROR: candidate requires recorded execution and the calling Codex session identity" >&2; exit 2;
  }
  env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.supervision \
    --health "$health_dir" --session "$worker_session_id" admit \
    --run-id "$worker_run_id" --repository "$worker_repository" --issue "$worker_issue" \
    --role "$worker_role" --checkout "$worker_repo_path" --source "$worker_source_repo_path" --log "$worker_log"
  supervision_admitted=1
fi
record_publication_failure() {
  local publication_phase=$1
  local publication_target=$2
  local publication_now
  publication_now=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
  env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.publication_cli \
    --records "$publication_failure_records" \
    --failure-id "$worker_run_id:$publication_phase:$publication_target" \
    --run-id "$worker_run_id" --phase "$publication_phase" --target "$publication_target" \
    --error-class ingestion-failed --observed-at "$publication_now" >/dev/null 2>&1 || \
      echo "WARN: publication failure record could not be written for run $worker_run_id" >&2
}
review_cli=(
  env PYTHONPATH="$candidate_source"
  python3 -m codex_local_harness.review
)
coder_cli=(
  env PYTHONPATH="$candidate_source"
  python3 -m codex_local_harness.coder
)

if [[ $worker_role == reviewer ]]; then
  [[ -n $worker_repository && -n $worker_issue && -n $worker_pr ]] || {
    echo "ERROR: reviewer requires CODEX_LOCAL_REPOSITORY, CODEX_LOCAL_ISSUE, and CODEX_LOCAL_PR" >&2
    exit 2
  }
  review_scratch_parent=${HOME}/.local/share/opencode-orchestration/reviewer-scratch
  install -d -m 700 "$review_scratch_parent"
  review_runtime_tmp=$(mktemp -d --tmpdir="$review_scratch_parent")
  if [[ $convergence == 1 ]]; then
    env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.review_profile \
      "$candidate_agents/convergence-reviewer.md" \
      "$worker_runtime_home/.config/opencode/agents/convergence-reviewer.md" \
      "$worker_repo_path" "$review_runtime_tmp" --container-tmpfs
  fi
  review_prepare_args=()
  [[ $convergence != 1 ]] || review_prepare_args+=(--investigative --container-tmpfs)
  review_prepare_base_args=()
  [[ -z "${base_sha:-}" ]] || review_prepare_base_args+=(--base-sha "$base_sha")
  worker_task=$("${review_cli[@]}" prepare "${review_prepare_args[@]}" "${review_prepare_base_args[@]}" \
    --checkout "$worker_repo_path" --repository "$worker_repository" \
    --issue "$worker_issue" --pr "$worker_pr" --task-file "$worker_task_file" \
    --envelope-out "$worker_envelope" --scratch-dir "$review_runtime_tmp" \
    --runtime-home "$worker_runtime_home") || exit 65
fi
if [[ $worker_role == coder && ${CODEX_LOCAL_CODER_POSTFLIGHT:-1} == 1 ]]; then
  worker_task=$'HARNESS DELIVERY BOUNDARY: Work only in the local checkout. Do not push, use gh, create a PR, comment, or change labels. Commit the verified implementation on a clean local issue branch; the deterministic harness owns all remote publication.\n\n'"$worker_task"
fi

# Local feedback is not publication authority. The final host check is unchanged.
case "${CODEX_LOCAL_DELIVERY_FEEDBACK:-1}" in
  0) ;;
  1)
    if [[ $worker_role == coder && $worker_runtime == qwen-code && ${CODEX_LOCAL_CODER_POSTFLIGHT:-1} == 1 ]]; then
      # Use pinned base_sha if available (from host base resolution), otherwise use merge-base
      if [[ -n "${base_sha:-}" ]]; then
        feedback_base="$base_sha"
      else
        feedback_base=$(git -C "$worker_repo_path" merge-base origin/main HEAD) || true
      fi
      if [[ -n "$feedback_base" ]] && \
        env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.delivery_feedback install \
          --runtime-home "$worker_runtime_home" --checkout "$worker_repo_path" --base "$feedback_base"; then
        worker_task=$'LOCAL DELIVERY FEEDBACK: A native Stop hook reports uncommitted changes and committed-diff whitespace errors before you finish. Use its evidence to repair your own work. If a genuine blocker remains, begin your final response with ESCALATE: and explain it. This feedback never authorizes publication; final host postflight remains authoritative.\n\n'"$worker_task"
      else
        echo "WARN: local delivery feedback setup failed; final host postflight remains authoritative" >&2
      fi
    fi
    ;;
  *) echo "ERROR: CODEX_LOCAL_DELIVERY_FEEDBACK must be 0 or 1" >&2; exit 64 ;;
esac

# Optional role-scoped memory. The issuer credential stays outside the sandbox;
# only a run-specific contributor/reader token reaches the worker.
memory_source=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../src" && pwd)
memory_args=(--config "${CODEX_LOCAL_MEMORY_CONFIG:-${HOME}/.config/codex-local/memory.json}"
  --runtime-home "$worker_runtime_home" --role "$worker_role"
  --run-id "$worker_run_id" --repository "$worker_repository" --issue "$worker_issue")
# Telemetry lands in the launcher's health directory only when recorded execution
# is on; CODEX_LOCAL_HEALTH_DIR remains the module-level fallback.
if [[ $record_run == 1 && -n $health_dir ]]; then
  memory_args+=(--health-dir "$health_dir")
fi
# The feature needs the issue title for a useful query. Fetch it only when recall
# is on AND an issue number and repository are known; a failed or slow fetch yields
# no title and never stops the run. With recall off this behaves exactly as before
# (no gh call).
if [[ ${CODEX_LOCAL_MEMORY_RECALL:-0} == 1 && -n $worker_issue && -n $worker_repository ]]; then
  issue_title=$(timeout 5 gh issue view "$worker_issue" --repo "$worker_repository" --json title --jq .title 2>/dev/null || true)
  memory_args+=(--issue-title "$issue_title")
fi
if ! env PYTHONPATH="$memory_source" python3 -m codex_local_harness.memory \
  "${memory_args[@]}"; then
  echo "WARN: optional memory setup failed; continuing without memory guidance" >&2
fi
if [[ -f "$worker_runtime_home/memory-guidance.txt" ]]; then
  worker_task="$(cat "$worker_runtime_home/memory-guidance.txt")"$'\n\n'"$worker_task"
  worker_task_file="$worker_runtime_home/memory-task.txt"
  printf '%s\n' "$worker_task" >"$worker_task_file"
fi

# Explicit operator opt-in: no production DB credentials enter this capability.
case "${CODEX_LOCAL_MEMORY_TEST_DB:-0}" in
  0) ;;
  1)
    [[ $worker_sandbox == container && $worker_role != helper ]] || {
      echo "ERROR: disposable memory testing requires a coder/reviewer container" >&2; exit 69;
    }
    env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.memory_test_db start \
      --run-id "$worker_run_id" --profile "$worker_runtime_home/memory-test-db.json" || exit 69
    worker_memory_test_db=1
    worker_task=$'DISPOSABLE DATABASE CAPABILITY: MEMORY_TEST_PROFILE points to synthetic credentials for your isolated temporary SurrealDB. No production credentials or Docker socket are available. You may run and rerun service tests with MEMORY_INTEGRATION=1 using the supplied profile. Do not print credentials. Host harness owns cleanup.\n\n'"$worker_task"
    worker_task_file="$worker_runtime_home/database-task.txt"
    printf '%s\n' "$worker_task" >"$worker_task_file"
    ;;
  *) echo "ERROR: CODEX_LOCAL_MEMORY_TEST_DB must be 0 or 1" >&2; exit 64 ;;
esac

echo "Starting local worker: role=$worker_role tier=$worker_tier runtime=$worker_runtime mode=$worker_mode model=$worker_model run_id=$worker_run_id" >&2
if [[ $record_run == 1 ]]; then
  worker_started_epoch=$(date -u +%s)
  diagnostic_now=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
  diagnostic_started=1
  if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.diagnostic_cli lifecycle \
    --records "$lifecycle_records" --event-id "$worker_run_id:started" \
    --run-id "$worker_run_id" --event started --observed-at "$diagnostic_now" \
    --issue "$worker_issue" --role "$worker_role" --model "$worker_model" \
    --profile codex-led-v4 --task-class "${CODEX_LOCAL_TASK_CLASS:-unclassified}" \
    "${lifecycle_checkout_args[@]}" >/dev/null; then
    echo "WARN: lifecycle telemetry ingestion failed for run $worker_run_id" >&2
    record_publication_failure start lifecycle
  fi
  if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.observe_cli workflow \
    --records "$workflow_records" --event-id "$worker_run_id:$worker_workflow_stage-started" \
    --operation-id "$worker_operation_id" --stage "$worker_workflow_stage" --state active \
    --observed-at "$diagnostic_now" --issue "$worker_issue" --run-id "$worker_run_id" \
    --role "$worker_role" --model "$worker_model" "${workflow_identity_args[@]}" >/dev/null; then
    echo "WARN: workflow telemetry ingestion failed for run $worker_run_id" >&2
    record_publication_failure start workflow
  fi
fi
if [[ $worker_model == deepseek/deepseek-v4-flash-0731-exl3-k2 ]]; then
  case "$worker_role" in
    coder)
      worker_contract='Use four bounded phases: inspect the directly relevant files, make the required edit, run the stated focused verification, then summarize and stop. Preserve the issue scope. If requirements conflict or evidence is missing, report the blocker.'
      ;;
    reviewer)
      worker_contract='Review the supplied issue, patch, and evidence. For each finding, identify the failing behavior, its triggering input or state, and whether surrounding code prevents it. Report only conclusions directly supported by evidence. Distinguish observed tests from reported tests. State uncertainty and missing evidence; do not guess. Follow the supplied review result schema and stop after returning it.'
      ;;
    helper)
      worker_contract='Investigate the supplied issue read-only. Separate observations, hypotheses, and conclusions. Consider alternative explanations and reject those contradicted by evidence. Return the narrowest supported conclusion, evidence references, uncertainties, and missing evidence. Do not guess when alternatives cannot be distinguished. Follow the supplied output requirements and stop after answering.'
      ;;
  esac
  worker_task="$worker_contract"$'\n\n'"$worker_task"
  # The bridge reads a file while native execution reads the string. Both
  # receive the final prepared packet, including reviewer evidence/schema.
  worker_task_file="$worker_runtime_home/structured-task.txt"
  printf '%s\n' "$worker_task" >"$worker_task_file"
fi
if [[ $convergence == 1 && $worker_role == coder ]]; then
  worker_task=$'Work toward the supplied functional acceptance criteria. Choose your own investigative sequence and continue while a useful next experiment remains. Repeated failures are evidence to reassess, not a reason to repeat unchanged actions. If you cannot identify a productive next step, report the specific missing fact or blocker for Codex guidance. Do not expand scope for unsolicited polish.\n\n'"$worker_task"
  worker_task_file="$worker_runtime_home/convergence-task.txt"
  printf '%s\n' "$worker_task" >"$worker_task_file"
fi
set +e
worker_env=(env -i HOME="$worker_runtime_home" USER="${USER:-worker}" LOGNAME="${LOGNAME:-worker}"
  PATH="$worker_path" XDG_CONFIG_HOME="$worker_runtime_home/.config"
  XDG_DATA_HOME="$worker_runtime_home/.local/share" XDG_CACHE_HOME="$worker_runtime_home/.cache"
  LANG=C.UTF-8 LC_ALL=C.UTF-8 TERM="${TERM:-dumb}" NO_COLOR=1)
if [[ $worker_sandbox == container ]]; then
  env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.worker_containers \
    --health "$health_dir" --max-age "$((worker_timeout + 60))" >/dev/null || \
    echo "WARN: worker-container sweep unavailable" >&2
fi
execution_env=()
if [[ $worker_role == reviewer ]]; then
  execution_env=(PYTHONDONTWRITEBYTECODE=1 PYTHONPYCACHEPREFIX="$review_runtime_tmp/pycache" \
    PYTEST_ADDOPTS="-p no:cacheprovider" COVERAGE_FILE="$review_runtime_tmp/.coverage" \
    TMPDIR="$review_runtime_tmp" PYTHONPATH="$worker_repo_path")
elif [[ $worker_role == coder ]]; then
  execution_env=(PYTHONDONTWRITEBYTECODE=1 PYTHONPYCACHEPREFIX="$worker_runtime_home/.cache/pycache" \
    PYTEST_ADDOPTS="-p no:cacheprovider" COVERAGE_FILE="$worker_runtime_home/.cache/.coverage")
fi
if [[ $worker_sandbox == container ]]; then
  repository_mount="type=bind,src=$worker_repo_path,dst=$worker_repo_path,readonly"
  [[ $worker_role == coder ]] && repository_mount="type=bind,src=$worker_repo_path,dst=$worker_repo_path"
  container_env=(HOME="$worker_runtime_home" USER="${USER:-worker}" LOGNAME="${LOGNAME:-worker}"
    XDG_CONFIG_HOME="$worker_runtime_home/.config" XDG_DATA_HOME="$worker_runtime_home/.local/share"
    XDG_CACHE_HOME="$worker_runtime_home/.cache" LANG=C.UTF-8 LC_ALL=C.UTF-8 TERM="${TERM:-dumb}"
    NO_COLOR=1 PYTHONDONTWRITEBYTECODE=1 PYTEST_ADDOPTS="-p no:cacheprovider")
  container_env+=("${execution_env[@]}")
  if [[ $worker_memory_test_db == 1 ]]; then
    container_env+=(MEMORY_TEST_PROFILE="$worker_runtime_home/memory-test-db.json" MEMORY_INTEGRATION=1)
  fi
  worker_server_container="codex-worker-$worker_run_id"
  worker_wrapper_ticks=$(python3 -c 'import sys; from pathlib import Path; print(Path("/proc/"+sys.argv[1]+"/stat").read_text().rsplit(")",1)[1].split()[19])' "$$")
  docker_args=(run --rm --sig-proxy=false --name "$worker_server_container"
    --label io.codex.worker.managed=1 --label "io.codex.worker.uid=$(id -u)"
    --label "io.codex.worker.run=$worker_run_id" --label "io.codex.worker.role=$worker_role"
    --label "io.codex.worker.pid=$$" --label "io.codex.worker.start_ticks=$worker_wrapper_ticks"
    --label "io.codex.worker.started=$(date +%s)"
    --network host --read-only --cap-drop ALL
    --security-opt no-new-privileges --pids-limit 512 --user "$(id -u):$(id -g)"
    --tmpfs /tmp:rw,nosuid,nodev,size=1g
    --mount "$repository_mount"
    --mount "type=bind,src=$worker_runtime_home,dst=$worker_runtime_home"
    --workdir "$worker_repo_path")
  [[ $worker_runtime != opencode ]] || docker_args+=(--mount "type=bind,src=$worker_opencode,dst=/usr/local/bin/opencode,readonly")
  # Operator-declared read-only tool mounts (validated; see sandbox_mounts.py).
  sandbox_mounts_config=${CODEX_LOCAL_SANDBOX_MOUNTS:-$HOME/.config/codex-local/sandbox-mounts.json}
  if [[ -e $sandbox_mounts_config ]]; then
    sandbox_mounts=$(env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.sandbox_mounts \
      --config "$sandbox_mounts_config" --home "$HOME" --worker-home "$worker_runtime_home") || {
      echo "ERROR: refusing to start worker with an invalid sandbox mount configuration" >&2; exit 65;
    }
    while IFS= read -r sandbox_mount; do
      [[ -n $sandbox_mount ]] || continue
      # Pre-create the mount point as the invoking user; otherwise Docker
      # creates it (and missing parents such as ~/.local/share) owned by root,
      # which blocks the worker's own XDG data directory and home cleanup.
      sandbox_target=${sandbox_mount#*,dst=}
      mkdir -p -- "${sandbox_target%,readonly}"
      docker_args+=(--mount "$sandbox_mount")
    done <<<"$sandbox_mounts"
  fi
  for item in "${container_env[@]}"; do docker_args+=(--env "$item"); done
  if [[ $worker_role == reviewer ]]; then
    docker_args+=(--mount "type=bind,src=$review_runtime_tmp,dst=$review_runtime_tmp")
  fi
  if [[ $convergence == 1 && -n ${CODEX_LOCAL_VERIFY_COMMAND:-} ]]; then
    docker "${docker_args[@]}" "$worker_container_image" sh -lc "$CODEX_LOCAL_VERIFY_COMMAND" || {
      echo "ERROR: verification capability check failed before inference" >&2; exit 69;
    }
    worker_task=$'HARNESS_OBSERVED_RUNTIME_CAPABILITY: The following command exited 0 inside this same worker container before inference. Prefer these verified runtime capabilities over host executable paths.\n'"$CODEX_LOCAL_VERIFY_COMMAND"$'\n\n'"$worker_task"
    worker_task_file="$worker_runtime_home/verified-task.txt"
    printf '%s\n' "$worker_task" >"$worker_task_file"
  fi
  if [[ $worker_runtime == qwen-code ]]; then
    qwen_model=${worker_model#vllm/}
    qwen_env=()
    if [[ $qwen_model == nvidia/Qwen3.5-122B-A10B-NVFP4 ]]; then
      qwen_env+=(--env QWEN_CODE_MAX_OUTPUT_TOKENS=8192)
    fi
    timeout --foreground --signal=TERM --kill-after=5s "$worker_timeout" \
      docker "${docker_args[@]}" \
      --env OPENAI_API_KEY=not-needed --env "OPENAI_BASE_URL=${CODEX_LOCAL_VLLM_ENDPOINT:-http://127.0.0.1:8000}/v1" \
      "${qwen_env[@]}" \
      "$worker_container_image" qwen --auth-type openai --approval-mode yolo --model "$qwen_model" \
      --output-format stream-json --prompt "$worker_task" >"$worker_log" &
    worker_server_pid=$!
    wait "$worker_server_pid"
  elif [[ $worker_mode == tailored && ${CODEX_LOCAL_SESSION_BRIDGE:-1} == 1 ]]; then
    worker_server_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
    worker_server_password=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
    worker_server_env="$worker_runtime_home/opencode-server.env"
    printf 'OPENCODE_SERVER_PASSWORD=%s\n' "$worker_server_password" >"$worker_server_env"
    printf '%s\n' "$worker_server_password" >"$worker_control_secret"
    chmod 600 "$worker_server_env" "$worker_control_secret"
    unset worker_server_password
    docker "${docker_args[@]}" \
      --env-file "$worker_server_env" "$worker_container_image" \
      opencode serve --hostname 127.0.0.1 --port "$worker_server_port" \
      >"$worker_runtime_home/opencode-server.log" 2>&1 &
    worker_server_pid=$!
    timeout --foreground --signal=TERM --kill-after=30s "$worker_timeout" \
      env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.opencode_bridge \
      --base-url "http://127.0.0.1:$worker_server_port" \
      --password-file "$worker_control_secret" --run-id "$worker_run_id" \
      --task-file "$worker_task_file" --agent "$worker_agent" --model "$worker_model" \
      --repository "$worker_repository_display" \
      "${bridge_compaction_args[@]}" \
      --log "$worker_log" --control "$worker_control" --secret "$worker_control_secret" \
      --timeout "$worker_timeout"
    bridge_status=$?
    if [[ -f $worker_control && $bridge_status != 0 ]]; then
      control_state=failed
      [[ $bridge_status == 124 || $bridge_status == 137 ]] && control_state=timed-out
      [[ $bridge_status == 130 || $bridge_status == 143 ]] && control_state=interrupted
      jq --arg state "$control_state" '.state = $state | .credential_file = null' "$worker_control" >"$worker_control.tmp" \
        && chmod 600 "$worker_control.tmp" && mv "$worker_control.tmp" "$worker_control" || true
    fi
    rm -f -- "$worker_control_secret"
    docker stop --time 5 "$worker_server_container" >/dev/null 2>&1 || true
    wait "$worker_server_pid" 2>/dev/null || true
    worker_server_pid=
    worker_server_container=
    (( bridge_status == 0 ))
  else
    opencode_args=(run --format json --dir "$worker_repo_path")
    [[ $worker_mode != tailored ]] || opencode_args+=(--agent "$worker_agent")
    timeout --foreground --signal=TERM --kill-after=5s "$worker_timeout" \
      docker "${docker_args[@]}" "$worker_container_image" \
      opencode "${opencode_args[@]}" --model "$worker_model" "$worker_task" >"$worker_log" &
    worker_server_pid=$!
    wait "$worker_server_pid"
  fi
else
  [[ $worker_runtime == opencode ]] || { echo "ERROR: qwen-code requires container confinement" >&2; exit 2; }
  opencode_args=(run --format json --dir "$worker_repo_path")
  [[ $worker_mode != tailored ]] || opencode_args+=(--agent "$worker_agent")
  "${worker_env[@]}" "${execution_env[@]}" timeout --foreground --signal=TERM --kill-after=30s "$worker_timeout" \
    "$worker_opencode" "${opencode_args[@]}" --model "$worker_model" "$worker_task" >"$worker_log"
fi
inference_status=$?
if [[ $convergence == 1 && -n ${bridge_status:-} ]]; then
  inference_status=$bridge_status
fi
set -e

reviewer_observed_tokens=0
reviewer_budget_reason=
if [[ $worker_role == reviewer ]]; then
  reviewer_usage_logs=("$worker_log")
  [[ ! -f "$worker_log.attempt-1" ]] || reviewer_usage_logs+=("$worker_log.attempt-1")
  reviewer_observed_tokens=$(jq -s '[.[] | select(.type == "step_finish") | (.part.tokens.total // 0)] | add // 0' "${reviewer_usage_logs[@]}")
  if [[ $convergence != 1 || -n ${CODEX_LOCAL_REVIEWER_TOKEN_BUDGET:-} ]] && (( reviewer_observed_tokens > reviewer_token_budget )); then
    reviewer_budget_reason=token-budget
  elif (( inference_status == 124 || inference_status == 137 )); then
    reviewer_budget_reason=wall-time-budget
  elif grep -q 'Maximum steps reached for this agent' "$worker_log"; then
    reviewer_budget_reason=step-budget
  fi
fi

output_status=0
if [[ $worker_runtime == qwen-code ]]; then
  jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text' "$worker_log" || output_status=$?
elif [[ $worker_agent == advisory ]]; then
  env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.runtime.advisory_output --log "$worker_log" || output_status=$?
else
  jq -r 'select(.type == "text") | .part.text' "$worker_log" || output_status=$?
fi
workflow_status=$inference_status
if (( workflow_status == 0 && output_status != 0 )); then
  workflow_status=65
fi
reviewer_has_result=0
if [[ $worker_role == reviewer ]] && jq -s -e '
  [.[] | select(.type == "text") | (.part.text // "") | split("\n")[] |
   select(startswith("REVIEW_RESULT_JSON="))] | length == 1
' "$worker_log" >/dev/null; then
  reviewer_has_result=1
fi
if [[ $worker_role == reviewer && -n $reviewer_budget_reason && $reviewer_has_result == 0 ]]; then
  "${review_cli[@]}" incomplete --envelope "$worker_envelope" --reason "$reviewer_budget_reason" \
    --result-out "$worker_result" || true
  workflow_status=75
elif [[ $worker_role == reviewer && $inference_status == 0 ]]; then
  set +e
  review_publish_args=()
  [[ ${CODEX_LOCAL_REVIEW_PUBLISH:-1} != 0 ]] || review_publish_args+=(--no-publish)
  if [[ ${CODEX_LOCAL_REVIEW_RESULT_MODE:-} == authoritative ]]; then
    review_publish_args+=(--health-records "$health_dir/review-normalization.jsonl")
  fi
  "${review_cli[@]}" finalize "${review_publish_args[@]}" --envelope "$worker_envelope" --log "$worker_log" \
    --run-id "$worker_run_id" --result-out "$worker_result"
  finalize_status=$?
  set -e
  if [[ $finalize_status == 76 ]]; then
    # Preserve the validated review and binding for explicit host adjudication.
    workflow_status=76
  elif [[ $finalize_status != 0 ]]; then
    "${review_cli[@]}" incomplete --envelope "$worker_envelope" --reason malformed-result \
      --result-out "$worker_result" || true
    workflow_status=65
  fi
fi
if [[ $worker_role == coder && $inference_status == 0 && ${CODEX_LOCAL_CODER_POSTFLIGHT:-1} == 1 ]]; then
  set +e
  coder_postflight_base_args=()
  [[ -z "${base_sha:-}" ]] || coder_postflight_base_args+=(--base-sha "$base_sha")
  "${coder_cli[@]}" --checkout "$worker_repo_path" --repository "$worker_repository" \
    --issue "$worker_issue" --result-out "$worker_result" --publish \
    --publication-failure-records "$publication_failure_records" --run-id "$worker_run_id" \
    "${coder_postflight_base_args[@]}"
  finalize_status=$?
  set -e
  [[ $finalize_status == 0 ]] || workflow_status=65
fi

if [[ $record_run == 1 ]]; then
  if [[ $convergence == 1 ]]; then
    env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.usage \
      --log "$worker_log" --runtime "$worker_runtime" --exit-status "$inference_status" \
      --records "$health_dir/usage.jsonl" --run-id "$worker_run_id"
  fi
  legacy_ledger=${CODEX_LOCAL_LEGACY_LEDGER:-${HOME}/.config/opencode/opencode-infra/ledger-record-run.sh}
  if [[ $convergence != 1 ]] && ! "$legacy_ledger" \
    "$worker_repository" "$worker_issue" "$worker_role" "$worker_model" "$worker_log" \
    "run_id=$worker_run_id runtime=$worker_runtime mode=$worker_mode inference_status=$inference_status workflow_status=$workflow_status"; then
    echo "WARN: legacy aggregate ledger ingestion failed for run $worker_run_id" >&2
    record_publication_failure finish legacy-ledger
  fi

  health_records=${CODEX_LOCAL_HEALTH_RECORDS:-$health_dir/runs.jsonl}
  task_class=${CODEX_LOCAL_TASK_CLASS:-unclassified}
  health_status=success
  failure_class=
  delivery_ready=true
  dirty_entries=0
  generated_artifacts=0
  if (( workflow_status != 0 )); then
    health_status=failure
    delivery_ready=false
    if (( inference_status != 0 )); then
      case "$inference_status" in
        124|137)
          health_status=timed-out
          if [[ $worker_role == reviewer ]]; then
            failure_class=review-wall-time-budget
          else
            failure_class=execution-timeout
          fi
          ;;
        130|143) health_status=interrupted; failure_class=execution-interrupted ;;
        *) failure_class=infrastructure-inference ;;
      esac
    else
      if [[ $workflow_status == 76 ]]; then
        failure_class=review-audit-adjudication-required
      elif [[ $reviewer_budget_reason == token-budget ]]; then
        failure_class=review-token-budget
      elif (( output_status != 0 )); then
        failure_class=malformed-result
      else
        failure_class=workflow-postflight
      fi
    fi
  fi
  if [[ $worker_role == coder ]]; then
    status_snapshot=$(git -C "$worker_repo_path" status --porcelain=v1)
    if [[ -n $status_snapshot ]]; then
      dirty_entries=$(grep -c '^' <<<"$status_snapshot")
      generated_artifacts=$(grep -Ec '(\.venv|(^|/)venv|__pycache__|\.pytest_cache|\.egg-info|\.pyc|\.coverage)' <<<"$status_snapshot" || true)
      delivery_ready=false
      if (( workflow_status == 0 )); then
        health_status=degraded
        failure_class=delivery-dirty-checkout
      fi
    fi
  fi
  health_args=(
    --log "$worker_log" --records "$health_records" --run-id "$worker_run_id"
    --issue "$worker_issue" --role "$worker_role" --model "$worker_model"
    --runtime "$worker_runtime"
    --profile codex-led-v4 --task-class "$task_class" --status "$health_status"
    --inference-status "$inference_status" --workflow-status "$workflow_status"
    --delivery-ready "$delivery_ready" --dirty-entries "$dirty_entries"
    --generated-artifacts "$generated_artifacts"
    --repository "$worker_repository"
  )
  [[ $convergence != 1 ]] || health_args+=(--canonical)
  [[ -z $worker_pr ]] || health_args+=(--pull-request "$worker_pr")
  [[ -z $failure_class ]] || health_args+=(--failure-class "$failure_class")
  (( output_status == 0 )) || health_args+=(--allow-malformed)
  if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.runtime.opencode "${health_args[@]}" >/dev/null; then
    echo "WARN: health telemetry ingestion failed for run $worker_run_id" >&2
    record_publication_failure finish health
  fi
  diagnostic_event=completed
  case "$inference_status" in
    124|137) diagnostic_event=timed-out ;;
    130|143) diagnostic_event=interrupted ;;
  esac
  diagnostic_now=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
  diagnostic_elapsed=$(( $(date -u +%s) - worker_started_epoch ))
  if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.diagnostic_cli lifecycle \
    --records "$lifecycle_records" --event-id "$worker_run_id:$diagnostic_event" \
    --run-id "$worker_run_id" --event "$diagnostic_event" --observed-at "$diagnostic_now" \
    --wall-seconds "$diagnostic_elapsed" --exit-status "$workflow_status" \
    --dirty-entries "$dirty_entries" --issue "$worker_issue" --role "$worker_role" \
    --model "$worker_model" --profile codex-led-v4 --task-class "$task_class" \
    "${lifecycle_checkout_args[@]}" >/dev/null; then
    echo "WARN: lifecycle telemetry ingestion failed for run $worker_run_id" >&2
    record_publication_failure finish lifecycle
  fi
  workflow_state=passed
  workflow_stop_args=()
  if (( workflow_status != 0 )); then
    workflow_state=failed
    case "$diagnostic_event" in
      timed-out|interrupted) workflow_state=interrupted; workflow_stop_args=(--stop-reason "$diagnostic_event") ;;
    esac
  fi
  if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.observe_cli workflow \
    --records "$workflow_records" --event-id "$worker_run_id:$worker_workflow_stage-$workflow_state" \
    --operation-id "$worker_operation_id" --stage "$worker_workflow_stage" --state "$workflow_state" \
    --observed-at "$diagnostic_now" --issue "$worker_issue" --run-id "$worker_run_id" \
    --role "$worker_role" --model "$worker_model" "${workflow_identity_args[@]}" \
    "${workflow_stop_args[@]}" >/dev/null; then
    echo "WARN: workflow telemetry ingestion failed for run $worker_run_id" >&2
    record_publication_failure finish workflow
  fi
  if [[ $worker_role == coder ]]; then
    delivery_state=failed
    [[ $delivery_ready == true ]] && delivery_state=passed
    if ! env PYTHONPATH="$candidate_source" python3 -m codex_local_harness.observe_cli workflow \
      --records "$workflow_records" --event-id "$worker_run_id:delivery-$delivery_state" \
      --operation-id "$worker_operation_id" --stage delivery --state "$delivery_state" \
      --observed-at "$diagnostic_now" --issue "$worker_issue" --run-id "$worker_run_id" \
      --role "$worker_role" --model "$worker_model" "${workflow_identity_args[@]}" >/dev/null; then
      echo "WARN: delivery telemetry ingestion failed for run $worker_run_id" >&2
      record_publication_failure finish delivery
    fi
  fi
  diagnostic_finalized=1
fi

exit "$workflow_status"
