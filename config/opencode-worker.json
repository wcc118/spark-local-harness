{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {},
  "permission": {
    "*": "allow"
  },
  "agent": {
    "coder": {
      "mode": "primary",
      "temperature": 0.2,
      "steps": 1000,
      "permission": {
        "task": "deny"
      }
    },
    "helper": {
      "mode": "primary",
      "temperature": 0.1,
      "steps": 200,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "github_*": "deny",
        "gitea_*": "deny"
      }
    }
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "Qwen/Qwen3-Coder-Next-FP8": {
          "limit": {
            "context": 185000,
            "output": 32768
          }
        }
      }
    }
  }
}
