[Unit]
Description=Codex Local Harness - Read-only diagnostic dashboard (loopback-only)
Documentation=https://github.com/wcc118/codex-local-harness/blob/main/docs/mvp-quickstart.md
After=network.target

[Service]
Type=simple
Environment=PYTHONPATH=%h/.local/share/codex-local-harness/runtime/current/src
ExecStart=/usr/bin/python3 -m codex_local_harness.dashboard \
    --runs %h/.local/share/codex-local-harness/health/runs.jsonl \
    --adjudications %h/.local/share/codex-local-harness/health/adjudications.jsonl \
    --lifecycle %h/.local/share/codex-local-harness/health/lifecycle.jsonl \
    --workflow %h/.local/share/codex-local-harness/health/workflow.jsonl \
    --frontier %h/.local/share/codex-local-harness/health/frontier.jsonl \
    --publication-failures %h/.local/share/codex-local-harness/health/publication-failures.jsonl \
    --operation-usage %h/.local/share/codex-local-harness/health/operation-usage.jsonl \
    --plans %h/.local/share/codex-local-harness/health/plans.jsonl \
    --v5-runs %h/.local/share/opencode-orchestration/runs \
    --annotations %h/.local/share/codex-local-harness/health/annotations.jsonl \
    --benchmark-manifest %h/.local/share/codex-local-harness/benchmark/benchmark-manifest.json \
    --benchmark-attempts %h/.local/share/codex-local-harness/benchmark/benchmark-attempts.jsonl \
    --benchmark-summaries %h/.local/share/codex-local-harness/benchmark/benchmark-summaries.jsonl \
    --control-token-file %h/.config/codex-local/dashboard-control.token \
    --control-audit-file %h/.local/share/codex-local-harness/control/decisions.jsonl \
    --host 127.0.0.1 \
    --port 8765 \
    --release v0.5.6 \
    --mode live
# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/codex-local-harness/control
PrivateTmp=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-dashboard
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
