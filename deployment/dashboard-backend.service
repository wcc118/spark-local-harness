[Unit]
Description=Codex Local Harness - Read-only diagnostic dashboard (loopback-only)
Documentation=https://github.com/wcc118/codex-local-harness/blob/main/docs/mvp-quickstart.md
After=network.target

[Service]
Type=simple
Environment=PYTHONPATH=%h/.local/share/codex-local-harness/runtime/current/src
ExecStart=/usr/bin/python3 -m codex_local_harness.dashboard \
    --runs %h/.local/share/codex-local-harness/health/runs.jsonl \
    --adjudications %h/.local/share/codex-local-harness/health/adjudications.jsonl \
    --lifecycle %h/.local/share/codex-local-harness/health/lifecycle.jsonl \
    --workflow %h/.local/share/codex-local-harness/health/workflow.jsonl \
    --frontier %h/.local/share/codex-local-harness/health/frontier.jsonl \
    --publication-failures %h/.local/share/codex-local-harness/health/publication-failures.jsonl \
    --operation-usage %h/.local/share/codex-local-harness/health/operation-usage.jsonl \
    --host 127.0.0.1 \
    --port 8765 \
    --release v0.2.0 \
    --mode live
# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-dashboard
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
