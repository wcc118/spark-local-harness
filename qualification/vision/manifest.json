      "model_only": false,
      "mutations": [],
      "defects": [
        {
          "id": "implausible-timestamp-1",
          "region_hint": "Active units tile, 'updated' line",
          "description": "Timestamp reads '56 years ago'.",
          "deterministic_detectable": true
        },
        {
          "id": "implausible-timestamp-2",
          "region_hint": "Pending checks tile, 'updated' line",
          "description": "Timestamp shows an epoch-zero ISO date (1970-01-01).",
          "deterministic_detectable": true
        },
        {
          "id": "low-contrast",
          "region_hint": "Last sync tile, small text below the value",
          "description": "Dark grey text on the dark card background is very low contrast.",
          "deterministic_detectable": true
        },
        {
          "id": "tiny-text",
          "region_hint": "Active units tile, build fingerprint line",
          "description": "Text rendered well below 10px.",
          "deterministic_detectable": true
        },
        {
          "id": "clipped-text",
          "region_hint": "Handling note panel",
          "description": "The note text is clipped by a fixed-height, overflow-hidden, no-wrap container.",
          "deterministic_detectable": true
        },
        {
          "id": "missing-accessible-name",
          "region_hint": "The two small icon buttons",
          "description": "Both icon buttons have no visible label and no accessible name.",
          "deterministic_detectable": true
        },
        {
          "id": "repeated-unavailable",
          "region_hint": "Selected unit detail panel",
          "description": "The word 'Unavailable' repeats four times in one panel.",
          "deterministic_detectable": true
        },
        {
          "id": "placeholder-text",
          "region_hint": "Bottom of the page",
          "description": "Unresolved template placeholder text '{{summary_placeholder}}'.",
          "deterministic_detectable": true
        }
      ]
    },
