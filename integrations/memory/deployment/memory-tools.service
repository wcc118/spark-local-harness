[Unit]
Description=Shared local memory MCP tools
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/connellwc83/projects/memory
ExecStart=/home/connellwc83/projects/memory/.venv/bin/python /home/connellwc83/projects/memory/memory_service.py
